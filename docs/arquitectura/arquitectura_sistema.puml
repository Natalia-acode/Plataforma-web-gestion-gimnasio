@startuml Arquitectura_Sistema
title Arquitectura del Sistema — Spring Boot (Java) · SQL Server
skinparam componentStyle rectangle

actor "Cliente" as cliente
actor "Recepción · Entrenador\n· Administración" as staff

package "Backend — Spring Boot" {
  component "API REST\n(Spring MVC + Spring Security JWT)" as api
  component "Capa de Servicios\n(lógica de negocio)" as servicios
  component "Planificador @Scheduled\n(renovaciones · cola · aforo)" as scheduler
  component "Capa de Datos\n(Spring Data JPA + Hibernate)" as datos
}

database "SQL Server\nGimnasioDB" as db

cloud "Pasarela de Pago\n(API REST · tokenización)" as pasarela
cloud "Servicio de Notificaciones\n(SMTP / push)" as notif

cliente --> api : "HTTPS · JSON + JWT"
staff --> api : "HTTPS · JSON + JWT"
api --> servicios
scheduler --> servicios
servicios --> datos
datos --> db : "JDBC (Hibernate)"
servicios --> pasarela : "tokenización y cobros"
servicios --> notif : "correos y avisos"

legend right
  Backend: Spring Boot (Java) — capas controller / service / repository.
  Base de datos: Microsoft SQL Server (DDL: BD/ddl_gimnasio.sql).
  Seguridad: JWT + BCrypt; tarjetas tokenizadas por la pasarela (PCI delegado, RNF-02).
  Detalle del backend: docs/clases/diagrama_clases_diseno.puml
endlegend
@enduml
